# Copy to .env (never commit .env) and set a strong password.
# SQL Server: user sa, database Attendance, host localhost on DB_PORT.
# The password needs at least 8 characters from three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=Change-Me-Str0ng!Passw0rd
DB_PORT=1433
# Host port the API is published on
API_PORT=8080
# Written to CreatedBy/ModifiedBy/SubmittedBy until authentication exists (decision #42)
AUDIT_USER=attendance-api
